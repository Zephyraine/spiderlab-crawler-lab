{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spiderlab-crawler-lab-worker",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/target/l1/books",
      "/target/l1/books/*"
    ]
  }
}
