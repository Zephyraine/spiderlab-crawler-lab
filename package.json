{
  "name": "crawler-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "sync:data": "node scripts/sync-real-data.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:cloudflare": "vite build",
    "build:pages": "vite build && node scripts/prepare-pages-build.mjs",
    "check:cloudflare": "npm run build:cloudflare && wrangler deploy --dry-run",
    "deploy:cloudflare": "wrangler deploy",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "cheerio": "^1.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "wrangler": "^4.156.2"
  }
}
